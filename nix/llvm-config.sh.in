#!/bin/sh
#
# This is a tool like llvm-config for the standalone MLIR built by flake.nix
# that is intended to support the uses in https://github.com/mlir-rs/mlir-sys
# but may not support all uses that the normal llvm-config supports.
#

error_and_quit() {
  echo "ERROR: $1" >&2
  echo "WARNING: This is a minimal llvm-config replacement that allows the" \
       "standalone MLIR built by https://github.com/project-llzk/llzk-nix-pkgs" \
       "to be used with https://github.com/mlir-rs/mlir-sys. It is not" \
       "guaranteed to support anything beyond the specific option" \
       "combinations used by mlir-sys." >&2
  echo "Usage: llvm-config [--link-static [--ignore-libllvm]] [option]" >&2
  exit 1
}

# Clients such as tblgen obtain the static archive list and library directory
# in separate calls.  Always report locations in the merged prefix so a
# preceding `--link-static --libs` query cannot be paired with the native
# LLVM library directory.
case "$1" in
  --prefix)
    echo "@out@"
    exit 0
    ;;
  --bindir)
    echo "@out@/bin"
    exit 0
    ;;
  --includedir)
    echo "@out@/include"
    exit 0
    ;;
  --libdir)
    echo "@out@/lib"
    exit 0
    ;;
esac

# The merged archive list is necessary only for static MLIR linking. Delegate
# all other llvm-config queries to the native tool.
if [ "$1" != "--link-static" ]; then
  exec "@originalTool@" "$@"
fi

# mlir-sys 230 passes --ignore-libllvm between --link-static and the queried
# option.  Consume it before dispatching, while retaining it for options that
# are delegated to the native llvm-config.
ignore_libllvm=
option="$2"
if [ "$option" = "--ignore-libllvm" ]; then
  ignore_libllvm=true
  option="$3"
fi

case "$option" in
  --prefix)
    echo "@out@"
    ;;
  --bindir)
    echo "@out@/bin"
    ;;
  --includedir)
    echo "@out@/include"
    ;;
  --libdir)
    echo "@out@/lib"
    ;;
  --libs)
    # static library file names with -l prefix instead of lib*.a
    find "@out@/lib" -name "lib*.a" ${ignore_libllvm:+! -name libLLVM.a} | \
    sed -e 's|.*/||' -e 's|\.a$||' -e 's|^lib|-l|' | \
    tr '\n' ' '
    echo
    ;;
  --libnames)
    # Just the static library file names
    find "@out@/lib" -name "lib*.a" ${ignore_libllvm:+! -name libLLVM.a} | \
    sed 's|.*/||' | \
    tr '\n' ' '
    echo
    ;;
  *)
    exec "@originalTool@" "$@"
    ;;
esac
